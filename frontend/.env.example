# Copy this file to .env.local for local development (Vite loads .env.local automatically)
# .env.local is ignored that one has the real secrets

# URL of the backend API server
VITE_API_URL=http://localhost:5001

# Supabase (client-safe publishable key only — never put service_role here)
# Local .env.local uses the dev Supabase project. Vercel dashboard uses the prod project.
# Dashboard: Project Settings → API → Project URL and anon/public key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
